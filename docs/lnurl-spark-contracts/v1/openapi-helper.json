            "ServiceBearer": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36,
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas.json#/$defs/HelperOperation"
                }
              }
            }
          },
          "default": {
            "description": "Helper error",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36,
                  "format": "uuid"
                }
              },
              "Cache-Control": {
