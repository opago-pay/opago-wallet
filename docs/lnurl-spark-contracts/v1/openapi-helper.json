    "/internal/spark/wallets/{pubkey}/transfers": {
      "get": {
        "operationId": "getHelperTransfers",
        "summary": "getHelperTransfers",
        "security": [
          {
            "ServiceBearer": []
          }
        ],
        "parameters": [
          {
            "name": "pubkey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 66,
              "pattern": "^0[23][0-9a-f]{64}$"
            }
          },
          {
            "name": "network",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "mainnet",
                "regtest"
              ]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
