{
  "openapi": "3.1.1",
  "info": {
    "title": "OPAGO Spark invoice helper",
    "version": "0.1.0",
    "description": "Implementation contract based on OPAGO plan V6. NOT a deployed API. Read protocol.md and decisions.md; x-opago-* fields are normative."
  },
  "servers": [
    {
      "url": "https://spark-helper.opago-internal.invalid",
      "description": "Deployment placeholder, no public ingress."
    }
