                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas.json#/$defs/Error"
                }
              }
            }
          }
        },
        "description": "Only svc-spark-helper. Durable execution and fencing semantics in protocol.md; missing row is unknown, never proof of not_executed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas.json#/$defs/HelperInvoiceRequest"
              }
            }
          }
        }
      }
    },
