  "components": {
    "securitySchemes": {
      "WalletBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Internal-issued wallet access token, scoped to one wallet and installation."
      },
      "AccountBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Keycloak account access token; issuer/audience/auth_time and party are verified internally."
      },
      "PosBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Device credential restricted to the registered POS."
      },
      "DeletionReceiptBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque receipt only for the corresponding deletion status."
      },
      "ServiceBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Service credential; never substitutes end-user authorization."
      }
    }
  }
