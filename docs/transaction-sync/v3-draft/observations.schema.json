{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:opago:transaction-sync:0.3.0-draft.1:observations",
  "title": "OPAGO multi-asset observation batch 0.3.0-draft.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "installation_id", "items"],
  "properties": {
    "schema_version": { "const": "0.3.0-draft.1" },
    "installation_id": { "$ref": "#/definitions/uuid" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/movement" },
          { "$ref": "#/definitions/trade" }
        ]
      }
    }
  },
  "definitions": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "network_id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]{1,31}:[A-Za-z0-9._-]{1,64}$"
    },
    "rail_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "asset_id": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^([a-z][a-z0-9]{1,31}:[A-Za-z0-9._-]{1,64}/[a-z][a-z0-9]{1,31}:[A-Za-z0-9._%-]{1,128}|fiat:[A-Z]{3})$"
    },
    "action_code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "source_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atoms", "scale"],
      "properties": {
        "atoms": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,77}$"
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        }
      }
    },
    "asset_amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "quantity"],
      "properties": {
        "asset_id": { "$ref": "#/definitions/asset_id" },
        "quantity": { "$ref": "#/definitions/quantity" }
      }
    },
    "native_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "value", "sub_index"],
      "properties": {
        "namespace": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_.]{1,63}$"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sub_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "settlement_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side", "asset_id", "network_id", "rail_id", "native_ref"],
      "properties": {
        "side": { "enum": ["base", "quote", "fee"] },
        "asset_id": { "$ref": "#/definitions/asset_id" },
        "network_id": {
          "oneOf": [{ "$ref": "#/definitions/network_id" }, { "type": "null" }]
        },
        "rail_id": { "$ref": "#/definitions/rail_id" },
        "native_ref": { "$ref": "#/definitions/native_ref" }
      }
    },
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "client_event_id", "activity_id", "seq", "observed_at",
        "source_id", "wallet_id", "network_id", "rail_id", "asset_id",
        "quantity", "direction", "action_code", "status", "native_ref"
      ],
      "properties": {
        "kind": { "const": "movement" },
        "client_event_id": { "$ref": "#/definitions/uuid" },
        "activity_id": { "$ref": "#/definitions/uuid" },
        "seq": { "type": "integer", "minimum": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "source_id": { "$ref": "#/definitions/source_id" },
        "wallet_id": { "$ref": "#/definitions/uuid" },
        "network_id": { "$ref": "#/definitions/network_id" },
        "rail_id": { "$ref": "#/definitions/rail_id" },
        "asset_id": { "$ref": "#/definitions/asset_id" },
        "quantity": { "$ref": "#/definitions/quantity" },
        "direction": { "enum": ["incoming", "outgoing"] },
        "action_code": { "$ref": "#/definitions/action_code" },
        "status": { "enum": ["pending", "settled", "failed", "reversed"] },
        "native_ref": { "$ref": "#/definitions/native_ref" },
        "supersedes_client_event_id": {
          "oneOf": [{ "$ref": "#/definitions/uuid" }, { "type": "null" }]
        },
        "correction_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "trade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "client_event_id", "activity_id", "seq", "observed_at",
        "source_id", "action_code", "status", "provider_order_id",
        "base", "quote", "amount_basis", "fees", "linked_movement_ids", "settlement_refs"
      ],
      "properties": {
        "kind": { "const": "trade" },
        "client_event_id": { "$ref": "#/definitions/uuid" },
        "activity_id": { "$ref": "#/definitions/uuid" },
        "seq": { "type": "integer", "minimum": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "source_id": { "$ref": "#/definitions/source_id" },
        "action_code": { "$ref": "#/definitions/action_code" },
        "status": {
          "enum": ["created", "pending", "partially_settled", "settled", "failed", "refunded"]
        },
        "provider_order_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "provider_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "base": {
          "oneOf": [{ "$ref": "#/definitions/asset_amount" }, { "type": "null" }]
        },
        "quote": {
          "oneOf": [{ "$ref": "#/definitions/asset_amount" }, { "type": "null" }]
        },
        "amount_basis": { "enum": ["estimated", "executed"] },
        "fees": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/definitions/asset_amount" }
        },
        "linked_movement_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/uuid" }
        },
        "settlement_refs": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/definitions/settlement_ref" }
        },
        "supersedes_client_event_id": {
          "oneOf": [{ "$ref": "#/definitions/uuid" }, { "type": "null" }]
        },
        "correction_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "allOf": [
        {
          "anyOf": [
            { "properties": { "base": { "type": "object" } } },
            { "properties": { "quote": { "type": "object" } } }
          ]
        },
        {
          "if": { "properties": { "status": { "const": "settled" } } },
          "then": {
            "properties": {
              "base": { "type": "object" },
              "quote": { "type": "object" },
              "amount_basis": { "const": "executed" },
              "settlement_refs": { "minItems": 2 }
            }
          }
        }
      ]
    }
  }
}
