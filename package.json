{
  "name": "opago-wallet",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test-isolation=none --test-concurrency=1 --test tests/*.test.cjs",
    "eid-backend": "node ./server/eid-backend.js",
    "demo:ocp": "node ./demo/ocp-server.js",
    "demo:travel-rule": "node ./demo/travel-rule-merchant.js",
    "hedera:provision": "node ./scripts/hedera-provision-testnet.cjs",
    "demo:hedera-checkout": "node ./demo/hedera-checkout-merchant.cjs --network testnet",
    "demo:hedera-checkout:mainnet": "node ./demo/hedera-checkout-merchant.cjs --network mainnet",
    "phase4:checkout-fixtures": "node ./scripts/hedera-phase4-checkout-fixtures.cjs",
    "phase5:verify": "node ./scripts/verify-phase5.cjs",
    "phase5:android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/finalize-phase5-android.ps1",
    "android:mainnet-candidate": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-hedera-mainnet-candidate.ps1",
    "android:production-candidate": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-production-mainnet-candidate.ps1",
    "mainnet:config:verify": "node ./scripts/verify-hedera-mainnet-build-config.cjs",
    "lightning:mainnet:config:verify": "node ./scripts/verify-lightning-mainnet-build-config.cjs",
    "production:config:verify": "node ./scripts/verify-production-mainnet-build-config.cjs",
    "contract:compile": "node ./scripts/compile-contracts.cjs",
    "contract:test": "node ./scripts/run-contract-tests.cjs",
    "contract:deploy:testnet": "node ./scripts/hedera-deploy-checkout.cjs --network testnet",
    "contract:verify:testnet": "node ./scripts/hedera-verify-checkout.cjs --network testnet",
    "contract:preflight:mainnet": "node ./scripts/hedera-mainnet-preflight.cjs",
    "contract:deploy:mainnet": "node ./scripts/hedera-deploy-checkout.cjs --network mainnet",
    "contract:verify:mainnet": "node ./scripts/hedera-verify-checkout.cjs --network mainnet"
  },
