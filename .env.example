# Expo variables are embedded in the client bundle. Never put secrets in EXPO_PUBLIC_*.
# Legacy global switch. Keep false and use the network-specific release flags.
EXPO_PUBLIC_ENABLE_MAINNET=false
# Safe default: Spark regtest. A production build must set both values below.
EXPO_PUBLIC_ENABLE_LIGHTNING_MAINNET=false
EXPO_PUBLIC_LIGHTNING_BUILD_PROFILE=regtest
# Grant/release candidates may enable Hedera Mainnet independently while the
# Lightning remains on its development network.
EXPO_PUBLIC_ENABLE_HEDERA_MAINNET=false
# Lightning fees are reviewed and approved for each payment. No build-wide fee cap.

# Safe local/default profile. Mainnet requires a separate release profile plus
# EXPO_PUBLIC_ENABLE_HEDERA_MAINNET=true; the app rejects mixed Hedera profiles.
EXPO_PUBLIC_HEDERA_BUILD_PROFILE=testnet
EXPO_PUBLIC_HEDERA_NETWORK=testnet
# Set only in an explicitly enabled Hedera Mainnet build.
EXPO_PUBLIC_HEDERA_ACTIVATION_API_URL=
EXPO_PUBLIC_HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
# Local test cap; balance permits payments up to available funds minus maximum fees.
EXPO_PUBLIC_HEDERA_MAX_TRANSFER_HBAR=1
# Public, verified Phase 3 testnet deployment from deployments/hedera-testnet.json.
EXPO_PUBLIC_HEDERA_CHECKOUT_CONTRACT_ID=0.0.9972670
# SHA-256 of the exact runtime bytecode independently matched through Mirror Node.
EXPO_PUBLIC_HEDERA_CHECKOUT_RUNTIME_SHA256=18dfd309cde03d2291101f3b77f8c5810664a5c52bbed3b63ccce4752d7943c8
# Operator/faucet keys belong only in local HEDERA_* shell variables for provisioning.
#
# Mainnet release values are public build metadata, never private keys. Configure
# them in the EAS production environment only after audit and final deployment:
# EXPO_PUBLIC_ENABLE_MAINNET=false
# EXPO_PUBLIC_ENABLE_LIGHTNING_MAINNET=true
# EXPO_PUBLIC_LIGHTNING_BUILD_PROFILE=mainnet
# EXPO_PUBLIC_ENABLE_HEDERA_MAINNET=true
# EXPO_PUBLIC_HEDERA_BUILD_PROFILE=mainnet
# EXPO_PUBLIC_HEDERA_NETWORK=mainnet
# EXPO_PUBLIC_HEDERA_ACTIVATION_API_URL=https://hedera-activation.opago.com
# EXPO_PUBLIC_HEDERA_MIRROR_NODE_URL=https://mainnet.mirrornode.hedera.com
# EXPO_PUBLIC_HEDERA_MAX_TRANSFER_HBAR=balance
# EXPO_PUBLIC_HEDERA_CHECKOUT_CONTRACT_ID=0.0.10850063
# EXPO_PUBLIC_HEDERA_CHECKOUT_RUNTIME_SHA256=18dfd309cde03d2291101f3b77f8c5810664a5c52bbed3b63ccce4752d7943c8
# Local merchant demo settings (never bundled into the app).
HEDERA_MERCHANT_ID=
HEDERA_MERCHANT_DEMO_PORT=3334
HEDERA_MERCHANT_DEMO_BIND_HOST=127.0.0.1

# Required only for eID-enabled LNURL payments.
EXPO_PUBLIC_EID_BACKEND_URL=


# Local HTTP is accepted only in development and only for private/loopback hosts.
EXPO_PUBLIC_ALLOW_INSECURE_HTTP=false

# Bundled eID reference backend. Demo mode requires a secret.
EID_PORT=5555
EID_BIND_HOST=127.0.0.1
EID_DEMO_MODE=false
EID_DEMO_SECRET=
EID_CALLBACK_SECRET=
EID_TCTOKEN_URL=
EID_ED25519_PRIVATE_KEY_PEM=
EID_ALLOWED_ORIGINS=
EID_SESSION_TTL_MS=300000
EID_MAX_ACTIVE_SESSIONS=10000
EID_SESSION_RATE_LIMIT_PER_MINUTE=30
EID_ALLOW_IN_MEMORY_REFERENCE_BACKEND=false

# OCP demo merchant.
OCP_DEMO_PORT=3333
OCP_DEMO_BIND_HOST=127.0.0.1
OCP_DEMO_PUBLIC_URL=http://127.0.0.1:3333/ocp
OCP_DEMO_LIGHTNING_INVOICE=
OCP_DEMO_QUOTE_TTL_MS=60000

# Travel Rule merchant demo.
EIDAS_DEMO_PORT=4444
EIDAS_DEMO_BIND_HOST=127.0.0.1
EIDAS_DEMO_PUBLIC_BASE_URL=http://127.0.0.1:4444
EIDAS_BACKEND_URL=http://127.0.0.1:5555
EIDAS_DEMO_AMOUNT_MSAT=1000
EIDAS_DEMO_INVOICE=
EIDAS_DEMO_INVOICE_URL=

# Optional local timing diagnostics: only fixed stage names and durations.
EXPO_PUBLIC_PERF_TRACE=false

# Optional crash diagnostics. Set false to disable in a new build.
EXPO_PUBLIC_SENTRY_ENABLED=true

# Optional confirmed native crash button in Settings > Advanced (iOS release only).
# Enable solely in a build used for diagnostics acceptance; normally false.
EXPO_PUBLIC_SENTRY_TEST_CONTROLS=false

# Optional F3 account services. Local wallet use does not need these.
# Keep disabled until the website configuration and secure wallet-session handoff
# are published and signup, email confirmation, login and return pass device tests.
# Website URLs come only from that contract; never hard-code the Workers test site.
# The only bootstrap is https://api.opago.com/api/v2/app/config.
# No Keycloak issuer/client/redirect, API alias, service secret or signing root is bundled.
EXPO_PUBLIC_OPAGO_F3_ENABLED=false
# Operator-approved distribution links on opago.com, Apple/TestFlight or Google Play.
EXPO_PUBLIC_OPAGO_F3_IOS_UPDATE_URL=
EXPO_PUBLIC_OPAGO_F3_ANDROID_UPDATE_URL=
